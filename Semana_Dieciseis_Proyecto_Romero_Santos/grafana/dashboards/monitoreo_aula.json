      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-aula"
          },
          "query": "import \"timezone\"\noption location = timezone.fixed(offset: -5h)\n\nbase = from(bucket: \"aula\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperatura\" and r.aula == \"${aula}\")\n  |> group()\n\nprom = base |> aggregateWindow(every: 1d, fn: mean, createEmpty: false) |> set(key: \"stat\", value: \"Promedio\")\nmaxi = base |> aggregateWindow(every: 1d, fn: max, createEmpty: false) |> set(key: \"stat\", value: \"Maximo\")\nmini = base |> aggregateWindow(every: 1d, fn: min, createEmpty: false) |> set(key: \"stat\", value: \"Minimo\")\n\nunion(tables: [prom, maxi, mini])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"stat\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"Promedio\", \"Maximo\", \"Minimo\"])\n  |> sort(columns: [\"_time\"], desc: true)",
          "refId": "A"
        }
      ],
      "title": "Agregaciones diarias de temperatura (última semana) - $aula",
